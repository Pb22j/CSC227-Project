import java.util.*;

public class Main {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		JobLoaderThread jobLoader = new JobLoaderThread("job.txt");
		
		
		Thread JobLoaderThread = new Thread(jobLoader);
		JobLoaderThread.start();
		Queue jq = jobLoader.getJobQueue();
		
		try {
			JobLoaderThread.join();
		} catch (InterruptedException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}
		
		//System.out.println("Job Queue");
		//jq.printQueue();
		
		ReadyQueue readyQueue = new ReadyQueue();
		ReadyLoaderThread readyLoader = new ReadyLoaderThread(jq, readyQueue);
		Thread ReadyLoaderThread = new Thread(readyLoader);
		ReadyLoaderThread.start();
		
		CPUScheduler rr = new CPUScheduler(readyQueue);
		List<ProcessFormat> outList= rr.roundRobin();
		for(int i=0;i<outList.size();i++) {
			System.out.println(outList.get(i).toString());
		}
		
		
	}

}
