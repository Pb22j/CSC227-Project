
public class ProcessFormat {
	
	private PCB process;
	private int startingTime;
	private int stoppingTime;
	private int brustValue;
	
	public ProcessFormat(PCB p,int start,int stop,int brust) {
		process=p.copyPCB();
		startingTime=start;
		stoppingTime=stop;
		brustValue=brust;
		startingTime=start;
		stoppingTime=stop;
	}

	public PCB getProcess() {
		return process;
	}

	public void setProcess(PCB process) {
		this.process = process;
	}

	public int getStartingTime() {
		return startingTime;
	}

	public void setStartingTime(int startingTime) {
		this.startingTime = startingTime;
	}

	public int getStoppingTime() {
		return stoppingTime;
	}

	public void setStoppingTime(int stoppingTime) {
		this.stoppingTime = stoppingTime;
	}

	public int getBrustValue() {
		return brustValue;
	}

	public void setBrustValue(int brustValue) {
		this.brustValue = brustValue;
	}

	@Override
	public String toString() {
		return "ProcessFormat [process=" + process.getPID() + ", WaitingTime=" + startingTime + ", TurnArroundTime=" + stoppingTime
				+ ", brustValue=" + brustValue + "]";
	}
	
	
	

}
