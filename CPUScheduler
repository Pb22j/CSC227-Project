import java.util.*;

public class CPUScheduler {
	
	private ReadyQueue readyQueue;
	private final int quantum = 6;//quantum for Round-Robin
	private int time;
	
	public CPUScheduler(ReadyQueue r) {
		this.readyQueue=r;
		this.time=0;
	}
	
	public List<ProcessFormat> roundRobin() {
		List<ProcessFormat> outputList = new ArrayList<ProcessFormat>();
		
		while(!readyQueue.readyQueue.isEmpty()) {
			PCB testPCB = readyQueue.peek();
			testPCB.setWaitingTime(time);
			if(testPCB.getBrustTime()<=quantum) {
				readyQueue.setLock(false); // to allow thread to add new jobs to readyQueue
				readyQueue.dequeue();
				int brustTmp=testPCB.getBrustTime();
				time+=testPCB.getBrustTime();
				testPCB.setBrustTime(0);
				testPCB.setTurnaroundTime(time);
				testPCB.setState("terminated");
				outputList.add(new ProcessFormat(testPCB, testPCB.getWaitingTime(), testPCB.getTurnaroundTime(), brustTmp));
			}
			else {
				readyQueue.setLock(true);
				readyQueue.dequeue();
				time+=quantum;
				testPCB.setBrustTime(testPCB.getBrustTime()-quantum);
				testPCB.setTurnaroundTime(time);
				testPCB.setState("ready");
				outputList.add(new ProcessFormat(testPCB, testPCB.getWaitingTime(), testPCB.getTurnaroundTime(), quantum));
				readyQueue.enqueue(testPCB);
				readyQueue.setLock(false);
			}
		}
		return outputList;
		
	}

}
