
public class ReadyQueue {
	
	Queue readyQueue;
	private final int memorySize = 2048;
	private int avilableMemory;
	private boolean lock;
	
	public ReadyQueue() {
		readyQueue=new Queue();
		avilableMemory=2048;
		lock=false;
	}
	
	public boolean enqueue(PCB p) {
		if(p==null || p.getSize()>avilableMemory || readyQueue.isFull())
			return false;
		avilableMemory-=p.getSize();
		readyQueue.enqueue(p);
		return true;
	}
	
	public PCB dequeue() {
		if(readyQueue.isEmpty())
			return null;
		PCB removedPCB = readyQueue.dequeue();
		avilableMemory+=removedPCB.getSize();
		return removedPCB;
	}
	
	public PCB peek() {
		if(readyQueue.isEmpty())
			return null;
		return readyQueue.peek();
	}
	
	public void printReadyQueue() {
		if(readyQueue.isEmpty())
			return;
		readyQueue.printQueue();
	}

	public boolean isLock() {
		return lock;
	}

	public void setLock(boolean lock) {
		this.lock = lock;
	}
	
	

}
